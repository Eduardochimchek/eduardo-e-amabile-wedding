# Public site URL for canonical, Open Graph, sitemap and robots.
# Set this in Vercel → Project → Settings → Environment Variables.
# Example: https://eduardo-e-amabile-wedding.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional webhook that receives RSVP JSON payloads from POST /api/rsvp
# Never commit real secrets.
RSVP_WEBHOOK_URL=

# Optional Open Graph image path is configured in src/config/wedding.ts → seo.ogImage
# after you add a file under public/images/wedding/ (e.g. og.jpg).
